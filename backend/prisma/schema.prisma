generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  // Sign-in tokens issued before this moment are refused: set by a password change and by
  // "sign out everywhere" (see middleware/auth.ts).
  tokensValidFrom DateTime?
  // Fingerprints (keyed one-way hashes) of the email address and mobile number, never the
  // values themselves; see services/contactService.ts. Empty only on accounts from before
  // they were required, which must add them before using the site.
  emailHash String? @unique
  phoneHash String? @unique
  // The name shown with the member's posts, in groups and on the common page: random, given
  // at registration, never their username (services/pseudonym.ts).
  pseudonym String  @unique
  // The member's own weightage, 0 to 1, from how they use ExiThreat (services/memberWeight.ts):
  // activity (days of use and time on the site), posting, and going through posts to vote.
  // Shown only to the member.
  weight          Float     @default(0.0)
  activityScore   Float     @default(0.0)
  postScore       Float     @default(0.0)
  voteScore       Float?
  weightUpdatedAt DateTime?

  groupMemberships GroupMember[]
  posts            Post[]        @relation("OCPosts")
  pushVotes        PushVote[]
  comments         Comment[]
  viewRecords      ViewRecord[]
  chatMessages     ChatMessage[]
  proMicLink       ProMicLink?
}

model Group {
  id          String   @id @default(uuid())
  name        String
  // The group's weight, 0 to 1: how active its members are (services/groupWeight.ts).
  trustScore  Float    @default(0.0)
  // Its two halves: members' days of use, and how many posts they went through.
  loginScore      Float     @default(0.0)
  reviewScore     Float?
  weightUpdatedAt DateTime?
  createdAt   DateTime @default(now())

  members      GroupMember[]
  placements   PostPlacement[]
  postHistory  PostHistory[]
  pushVotes    PushVote[]
  chatMessages ChatMessage[]
}

model GroupMember {
  id             String   @id @default(uuid())
  groupId        String
  userId         String
  joinedAt       DateTime @default(now())
  lastSeenAt     DateTime? // last time the member used the group; decides who counts in a vote
  visitCount     Int      @default(0)
  totalTimeSpent Int      @default(0) // seconds
  readThroughCount Int    @default(0)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model Post {
  id               String    @id @default(uuid())
  originalContent  String    // plain text in the database; sent to clients only as a PNG
  redactedContent  String
  ocUserId         String
  totalWeight      Float     @default(0.0)
  lastManualPushAt DateTime?
  createdAt        DateTime  @default(now())
  // Forwarding goes round the eligible groups in cycles: groups reached since this moment are
  // not sent the post again until every eligible group has had it (null: since it was posted).
  cycleStartedAt   DateTime?
  // Which round of the eligible groups it is on: 1, then 2 once all of them have had it, …
  cycle            Int       @default(1)
  // Its spread (services/spread.ts): eligible groups it has reached, of how many, and that
  // share per day since it was posted. Listed on the common page once it reached 20%.
  reachedGroups    Int       @default(0)
  eligibleGroups   Int       @default(0)
  spreadScore      Float     @default(0)
  spreadUpdatedAt  DateTime?
  listedAt         DateTime?

  oc          User          @relation("OCPosts", fields: [ocUserId], references: [id])
  // The groups it is in now: one at first, up to five once pushes forward it to several.
  placements  PostPlacement[]
  pushVotes   PushVote[]
  history     PostHistory[]
  comments    Comment[]
  viewRecords ViewRecord[]

  @@index([ocUserId])
  @@index([listedAt, spreadScore])
}

// Tracks each vote cast on a post within a specific group
model PushVote {
  id      String   @id @default(uuid())
  postId  String
  groupId String
  userId  String
  votedAt DateTime @default(now())

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, groupId, userId]) // one vote per member per post per group
}

// Immutable record of each group a post has passed through
model PostHistory {
  id             String   @id @default(uuid())
  postId         String
  groupId        String
  pushPercentage Float    // % of members who voted push in this group
  arrivedAt      DateTime @default(now()) // when the post reached this group
  movedAt        DateTime @default(now()) // when it left
  wasManualPush  Boolean  @default(false)
  // How it reached this group: "start" (written there), "group" (fromGroupId pushed it on) or
  // "author" (the author's push). Copied from its placement when it leaves.
  arrivedBy      String   @default("start")
  fromGroupId    String?

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([postId])
}

// Tagged comments that travel with the post across groups
model Comment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

// Who has had the first look at a post's unredacted content. `viewedAt` is when it was first
// opened; `completedAt` is when the reader closed it. Until it is closed it can be reopened
// for a short time (see FIRST_LOOK_WINDOW_MS in routes/posts.ts).
model ViewRecord {
  id          String    @id @default(uuid())
  postId      String
  userId      String
  viewedAt    DateTime  @default(now())
  completedAt DateTime?
  // When the reader was shown the redacted version after the first look: with completedAt,
  // the post counts as gone through for the group's weight.
  redactedSeenAt DateTime?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

// Group-local chat — does NOT travel with posts
model ChatMessage {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  content   String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

// Links an ExiThreat account to the same person's ProMic host account (a Firebase uid in the
// ProMic project), established by redeeming a one-time code generated on the host's own device.
// Grants this user read access to that host's backup audio/video — see routes/promic.ts.
model ProMicLink {
  id       String   @id @default(uuid())
  userId   String   @unique
  hostId   String
  linkedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A 6-digit code sent to an email address or mobile number, and, once entered, the proof
// that the user owns it. Used once; rows older than a day are removed.
model ContactVerification {
  id         String    @id @default(uuid())
  channel    String    // "email" or "phone"
  targetHash String    // fingerprint of the address or number
  codeHash   String
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  verifiedAt DateTime?

  @@index([targetHash, createdAt])
}

// A day (in India) on which a user used ExiThreat while signed in. Counted for their own
// weightage and their group's over the last 30 days; removed after 60.
model UserActiveDay {
  userId  String
  day     String // YYYY-MM-DD
  seconds Int    @default(0) // time on the site that day, from the website's heartbeat

  @@id([userId, day])
  @@index([day])
}

// A group a post is in now. A post leaves a group when that group pushes it on (the row is
// removed and a PostHistory row records the stay); the author's push only adds groups.
model PostPlacement {
  id        String   @id @default(uuid())
  postId    String
  groupId   String
  arrivedAt DateTime @default(now())
  // "start", "group" (from fromGroupId) or "author": the edges of the author's group map.
  arrivedBy   String  @default("start")
  fromGroupId String?

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([postId, groupId])
  @@index([groupId])
}
