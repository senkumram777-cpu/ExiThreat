generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  groupMemberships GroupMember[]
  posts            Post[]        @relation("OCPosts")
  pushVotes        PushVote[]
  comments         Comment[]
  viewRecords      ViewRecord[]
  chatMessages     ChatMessage[]
  proMicLink       ProMicLink?
}

model Group {
  id          String   @id @default(uuid())
  name        String
  trustScore  Float    @default(0.0)
  createdAt   DateTime @default(now())

  members      GroupMember[]
  currentPosts Post[]
  postHistory  PostHistory[]
  pushVotes    PushVote[]
  chatMessages ChatMessage[]
}

model GroupMember {
  id             String   @id @default(uuid())
  groupId        String
  userId         String
  joinedAt       DateTime @default(now())
  lastSeenAt     DateTime? // last time the member used the group; decides who counts in a vote
  visitCount     Int      @default(0)
  totalTimeSpent Int      @default(0) // seconds
  readThroughCount Int    @default(0)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Post {
  id               String    @id @default(uuid())
  originalContent  String    // plain text in the database; sent to clients only as a PNG
  redactedContent  String
  ocUserId         String
  currentGroupId   String
  totalWeight      Float     @default(0.0)
  lastManualPushAt DateTime?
  createdAt        DateTime  @default(now())

  oc          User          @relation("OCPosts", fields: [ocUserId], references: [id])
  currentGroup Group        @relation(fields: [currentGroupId], references: [id])
  pushVotes   PushVote[]
  history     PostHistory[]
  comments    Comment[]
  viewRecords ViewRecord[]
}

// Tracks each vote cast on a post within a specific group
model PushVote {
  id      String   @id @default(uuid())
  postId  String
  groupId String
  userId  String
  votedAt DateTime @default(now())

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, groupId, userId]) // one vote per member per post per group
}

// Immutable record of each group a post has passed through
model PostHistory {
  id             String   @id @default(uuid())
  postId         String
  groupId        String
  pushPercentage Float    // % of members who voted push in this group
  movedAt        DateTime @default(now())
  wasManualPush  Boolean  @default(false)

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

// Tagged comments that travel with the post across groups
model Comment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Who has had the first look at a post's unredacted content. `viewedAt` is when it was first
// opened; `completedAt` is when the reader closed it. Until it is closed it can be reopened
// for a short time (see FIRST_LOOK_WINDOW_MS in routes/posts.ts).
model ViewRecord {
  id          String    @id @default(uuid())
  postId      String
  userId      String
  viewedAt    DateTime  @default(now())
  completedAt DateTime?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

// Group-local chat — does NOT travel with posts
model ChatMessage {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  content   String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Links an ExiThreat account to the same person's ProMic host account (a Firebase uid in the
// ProMic project), established by redeeming a one-time code generated on the host's own device.
// Grants this user read access to that host's backup audio/video — see routes/promic.ts.
model ProMicLink {
  id       String   @id @default(uuid())
  userId   String   @unique
  hostId   String
  linkedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
