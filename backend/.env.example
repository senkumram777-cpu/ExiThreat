DATABASE_URL=postgresql://exithreat:exithreat_dev@localhost:5432/exithreat
# Signs the sign-in tokens. The server does not start without it, and a hosted server
# refuses this example value: use a long random one (openssl rand -hex 32).
JWT_SECRET=change-me-in-production-use-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:3000

# ── Accounts: one per email address and mobile number ───────────────────────
# Key for the fingerprints of email addresses and mobile numbers (never stored themselves).
# At least 32 random characters (openssl rand -hex 32). Never change it once accounts exist.
CONTACT_HASH_SECRET=
# Email codes are sent from this Gmail account with an app password (the same account
# ProMic's Cloud Functions use). Off the host, without them the code is printed to the console.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Mobile numbers are confirmed by Firebase Phone Authentication on ProMic's project, checked
# with the PROMIC_SERVICE_ACCOUNT_* key below. Nothing else to set here.
PORT=4000

# ── Groups (optional; these are the defaults) ───────────────────────────────
# A group receives posts, and its votes count, from this many members.
# GROUP_MIN_MEMBERS=5
# No one is added to a group of this size.
# GROUP_MAX_MEMBERS=25
# Accounts one network address may create in 24 hours.
# REGISTER_LIMIT_PER_DAY=20
# Codes one network address may ask for in an hour.
# CODE_SENDS_PER_HOUR=20
# Wrong passwords allowed per address and account name in 15 minutes.
# LOGIN_ATTEMPTS=10

# ── ProMic integration (optional) ───────────────────────────────────────────
# Lets a user open their ProMic backup audio/video from their ExiThreat account.
# Needs a service account key from the ProMic Firebase project (Firebase console →
# Project settings → Service accounts → Generate new private key). Give either a path to
# the downloaded file or its contents as one line of JSON. Never commit the key.
PROMIC_DATABASE_URL=https://promic-c5567-default-rtdb.firebaseio.com
PROMIC_STORAGE_BUCKET=promic-c5567.firebasestorage.app
PROMIC_SERVICE_ACCOUNT_PATH=
# PROMIC_SERVICE_ACCOUNT_JSON=
