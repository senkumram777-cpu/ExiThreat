DATABASE_URL=postgresql://exithreat:exithreat_dev@localhost:5432/exithreat
JWT_SECRET=change-me-in-production-use-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:3000
PORT=4000

# ── Groups (optional; these are the defaults) ───────────────────────────────
# A group receives posts, and its votes count, from this many members.
# GROUP_MIN_MEMBERS=5
# No one is added to a group of this size.
# GROUP_MAX_MEMBERS=25
# Accounts one network address may create in 24 hours.
# REGISTER_LIMIT_PER_DAY=5

# ── ProMic integration (optional) ───────────────────────────────────────────
# Lets a user open their ProMic backup audio/video from their ExiThreat account.
# Needs a service account key from the ProMic Firebase project (Firebase console →
# Project settings → Service accounts → Generate new private key). Give either a path to
# the downloaded file or its contents as one line of JSON. Never commit the key.
PROMIC_DATABASE_URL=https://promic-c5567-default-rtdb.firebaseio.com
PROMIC_STORAGE_BUCKET=promic-c5567.firebasestorage.app
PROMIC_SERVICE_ACCOUNT_PATH=
# PROMIC_SERVICE_ACCOUNT_JSON=
